---
layout: base.njk
---
<article class="reading">
  <a class="back" href="/">← 回到手记</a>
  <header class="article-header"><div class="eyebrow">{{ category or 'ABOUT THIS NOTEBOOK' }}</div><h1>{{ title }}</h1>{% if category %}<p><time datetime="{{ page.date | isoDate }}">{{ page.date | dateLabel }}</time> · {{ content | reading }} 分钟阅读 · {{ site.author }}</p>{% endif %}</header>
  <div class="prose">{{ content | safe }}</div>
  <div class="article-end">— 感谢阅读 —</div>
</article>
