---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>{{ site.name }}</title><link>{{ site.url }}/</link><description>{{ site.description }}</description><language>zh-cn</language>{% for post in collections.articles %}<item><title>{{ post.data.title }}</title><link>{{ site.url }}{{ post.url }}</link><guid>{{ site.url }}{{ post.url }}</guid><description>{{ post.data.description }}</description></item>{% endfor %}</channel></rss>
